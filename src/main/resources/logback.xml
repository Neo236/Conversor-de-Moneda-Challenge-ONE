<configuration>
    <appender name="STDOUT" class="ch.qos.logback.core.ConsoleAppender">
        <encoder>
            <pattern>%d{yyyy-MM-dd HH:mm:ss} [%thread] %-5level %logger{36} - %msg%n</pattern>
        </encoder>
    </appender>

    <!-- Optionally, a file appender for keeping logs -->
    <appender name="FILE" class="ch.qos.logback.core.FileAppender">
        <file>application.log</file>
        <append>true</append>
        <encoder>
            <pattern>%d{yyyy-MM-dd HH:mm:ss} [%thread] %-5level %logger{36} - %msg%n</pattern>
        </encoder>
    </appender>

    <!-- Configure root logger. For this CLI, we probably want to keep the console clean except for errors -->
    <!-- So we set ROOT level to ERROR for console, but can log INFO to FILE -->
    <root level="ERROR">
        <appender-ref ref="STDOUT" />
    </root>

    <!-- App-specific logger, let's log INFO and above to file -->
    <logger name="com.alura.conversor" level="INFO" additivity="false">
        <appender-ref ref="FILE" />
        <appender-ref ref="STDOUT" />
    </logger>
</configuration>
